#!/bin/bash
# Installed at /usr/local/bin/flight-openclaw-secrets; runs as root before every gateway start.
# Copies the LLM key and the Telegram bot token from Secrets Manager into ~ubuntu/.openclaw/.env
# (mode 600). Keys never live in the AMI, the repo, or the chat: rotate = edit the secret + restart.
set -euo pipefail
R=us-east-1
LLM=$(aws secretsmanager get-secret-value --secret-id flight/llm --region $R --query SecretString --output text)
TG=$(aws secretsmanager get-secret-value --secret-id flight/telegram --region $R --query SecretString --output text)
python3 - "$LLM" "$TG" > /home/ubuntu/.openclaw/.env.tmp <<'PY'
import json, sys
llm, tg = json.loads(sys.argv[1]), json.loads(sys.argv[2])
var = {"openai": "OPENAI_API_KEY", "anthropic": "ANTHROPIC_API_KEY"}[llm.get("provider", "openai")]
print(f"{var}={llm['api_key']}")
print(f"TELEGRAM_BOT_TOKEN={tg['bot_token']}")
PY
chown ubuntu:ubuntu /home/ubuntu/.openclaw/.env.tmp
chmod 600 /home/ubuntu/.openclaw/.env.tmp
mv /home/ubuntu/.openclaw/.env.tmp /home/ubuntu/.openclaw/.env
